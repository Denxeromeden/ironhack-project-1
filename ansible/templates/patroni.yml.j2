scope: vote-postgres
namespace: /service/
name: "{{ inventory_hostname }}"

restapi:
  listen: 0.0.0.0:8008
  connect_address: "{{ ip }}:8008"

etcd3:
  hosts:
{% for host in groups['etcd'] %}
    - "{{ hostvars[host].ip }}:2379"
{% endfor %}

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    maximum_lag_on_syncnode: 1048576
    check_timeline: true
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        wal_level: replica
        hot_standby: "on"
        wal_log_hints: "on"
        max_wal_senders: 10
        max_replication_slots: 10
        max_connections: 100

  initdb:
    - encoding: UTF8
    - data-checksums

  pg_hba:
    - "local all postgres peer"
    - "host replication replication 127.0.0.1/32 scram-sha-256"
    - "host all all 127.0.0.1/32 scram-sha-256"
{% for host in groups['database'] %}
    - "host replication replication {{ hostvars[host].ip }}/32 scram-sha-256"
    - "host all {{ pg_user }} {{ hostvars[host].ip }}/32 scram-sha-256"
{% endfor %}
{% for host in groups['ha_proxy'] %}
    - "host {{ pg_db }} {{ pg_user }} {{ hostvars[host].ip }}/32 scram-sha-256"
{% endfor %}
{% for host in groups['frontend'] %}
    - "host {{ pg_db }} {{ pg_user }} {{ hostvars[host].ip }}/32 scram-sha-256"
{% endfor %}

postgresql:
  listen: "0.0.0.0:5432"
  connect_address: "{{ ip }}:5432"
  data_dir: /var/lib/postgresql/18/docker
  bin_dir: /usr/lib/postgresql/18/bin
  authentication:
    superuser:
      username: "{{ pg_user }}"
      password: "{{ pg_pass }}"
    replication:
      username: replication
      password: "{{ pg_replication_pass }}"
    rewind:
      username: "{{ pg_user }}"
      password: "{{ pg_pass }}"
  parameters:
    unix_socket_directories: /var/run/postgresql

  create_replica_methods:
    - basebackup

  basebackup:
    checkpoint: fast

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false