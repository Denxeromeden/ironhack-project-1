FROM curlimages/curl:8.23.0@sha256:a134550be58ab783810e613ae96fd253c38f7bdd16d9bf9be350700c7a29ac06 AS ca-bundle

FROM postgres:18.6-trixie@sha256:74935e72241653ca55e0414067e6d8763aceb8a810eb51b452253ec3dcfc4336

USER root

COPY --from=ca-bundle \
    /etc/ssl/certs/ca-certificates.crt \
    /etc/ssl/certs/ca-certificates.crt

#Force usage of https to comply with AWS security group egress restrictions and install necessary packages
RUN set -eux; \
    find /etc/apt -type f \( -name '*.list' -o -name '*.sources'\) \
      -exec sed -i \
        -e 's|http://deb.debian.org|https://deb.debian.org|g' \
        -e 's|http://security.debian.org|https://security.debian.org|g' \
        -e 's|http://apt.postgresql.org|https://apt.postgresql.org|g' \
        {} +; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
        python3-venv; \
    update-ca-certificates; \
    python3 -m venv /opt/patroni-venv; \
    /opt/patroni-venv/bin/pip install --no-cache-dir \
        "patroni[etcd3,psycopg3]==4.1.5"; \
    rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/patroni-venv/bin:/usr/lib/postgresql/18/bin:${PATH}"
ENV PGDATA="/var/lib/postgresql/18/docker"

RUN mkdir -p /etc/patroni /var/lib/postgresql/18/docker \
    && chown -R postgres:postgres \
       /etc/patroni /var/lib/postgresql \
    && chmod 0700 /var/lib/postgresql/18/docker

USER postgres

ENTRYPOINT ["patroni"]
CMD ["/etc/patroni/patroni.yml"]